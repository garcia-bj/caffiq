{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "CommonJS",
    "moduleResolution":  "node",
    "outDir":            "./dist",
    "rootDir":           "./",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "baseUrl":           ".",
    "paths": {
      "@config/*":  ["config/*"],
      "@modules/*": ["modules/*"],
      "@shared/*":  ["shared/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
